.python-version

# Temporary files
*.tmp
*~
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# MyPy
.mypy_cache/

# PyTest
.pytest_cache/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
